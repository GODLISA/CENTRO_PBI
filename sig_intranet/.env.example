# Copiar este archivo como .env y completar los valores.
# El .env se parsea a mano en sig_intranet/settings.py (sin python-dotenv):
# una variable por línea, sin comillas y sin comentarios al final de la línea.

# === Django ===
SECRET_KEY=cambiar_esta_clave

# === API externa (actualización de paneles Power BI) ===
API_BASE_URL=
API_BASE_TOKEN=

# === Conexión SQL Server (módulo Inventarios / StockRepuestos) ===
SQL_SERVER=192.168.0.10
SQL_PORT=1433
SQL_DATABASE=NombreBaseDatos
SQL_USER=usuario_lectura
SQL_PASSWORD=cambiar_esta_clave

# Driver ODBC. Si se deja vacío, el módulo detecta el mejor disponible.
# Ejemplos: ODBC Driver 18 for SQL Server / ODBC Driver 17 for SQL Server / SQL Server
SQL_DRIVER=

# Columna con la descripción del artículo. Vacío = autodetección
# (DESCRIPCION, DESC_SAP, DETALLE, GLOSA, NOMBRE, ...)
SQL_COL_DESCRIPCION=

# TrustServerCertificate=yes evita errores de certificado en servidores internos
SQL_TRUST_CERT=yes
SQL_ENCRYPT=no
SQL_TIMEOUT=30

# === Salida ===
# Carpeta donde se dejan los PDF generados (uno por bodega).
# Si es relativa, se resuelve desde sig_intranet/
OUTPUT_DIR=PDF_StockRepuestos
